{
  "name": "ryokan-system-v3-front",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "emulators": "firebase emulators:start --project demo-ryokan --only firestore,auth",
    "seed": "tsx --env-file=.env.development scripts/localdev/seed.ts",
    "anonymize": "bash scripts/localdev/anonymize.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:tz": "for tz in UTC Asia/Tokyo America/Los_Angeles; do echo \"TZ=$tz\"; TZ=$tz vitest run tests/time || exit 1; done",
    "test:emulator": "firebase emulators:exec --project demo-ryokan --only firestore,auth \"vitest run --config vitest.emulator.config.ts\"",
    "e2e": "playwright test",
    "e2e:prod": "playwright test -c playwright.prod.config.ts",
    "perf": "playwright test -c playwright.perf.config.ts",
    "e2e:emulator": "firebase emulators:exec --project demo-ryokan --only firestore,auth \"playwright test -c playwright.emulator.config.ts\"",
    "audit:ci": "tsx scripts/ci/audit.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@mui/x-date-pickers": "^9.17.0",
    "dayjs": "^1.11.23",
    "firebase-admin": "^14.5.0",
    "next": "^16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "^14.0.3",
    "world-countries": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/ui": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fast-check": "^4.10.2",
    "firebase": "^13.2.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "@firebase/util": false,
    "esbuild": false,
    "fsevents": false,
    "protobufjs": false,
    "unrs-resolver": false
  }
}
