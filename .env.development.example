# ローカル開発は Firebase Emulator にだけ接続する（docs/Development.md）
# 本番の鍵（FIREBASE_PRIVATE_KEY など）は置かない。置くと起動が拒否される

# サーバー側
FIREBASE_PROJECT_ID=demo-ryokan
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ブラウザ側（project ID と Auth Emulator の接続先はサーバー側と揃える）
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-ryokan
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ryokan.firebaseapp.com
