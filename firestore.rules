rules_version = '2';

// Firestore Security Rules（T6-2。docs/Security/SecurityMeasures/T6.md）
// ブラウザ（Client SDK）からの読み書きは、ログインしていてもいなくてもすべて拒否する。
// サーバー（Route Handler）は Admin SDK を使い、Admin SDK はこのルールの影響を受けない。
// テスト: tests/emulator/firestoreRules.test.ts。本番への反映は開発者が手で行う（firebase deploy --only firestore:rules）
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
