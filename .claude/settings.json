{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gcloud *)",
      "Bash(firebase deploy *)",
      "Bash(firebase login *)",
      "Bash(gh *)",
      "Bash(docker push *)",
      "Bash(npm publish *)",
      "Bash(ssh-add *)",
      "Bash(npm run anonymize *)",
      "Bash(make anonymize)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/configstore/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.development.example)",
      "Read(.localdev/**)",
      "Read(gha-creds-*.json)",
      "Read(*.pem)"
    ],
    "ask": [
      "Edit(.github/workflows/**)"
    ]
  }
}
